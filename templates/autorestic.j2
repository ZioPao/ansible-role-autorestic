backends:
  remote:
    type: s3
    path: s3.us-west-002.backblazeb2.com/{{ bucket }}/appdata-{{inventory_hostname}}
    env:
      aws_access_key_id: {{ access_key_id }}
      aws_secret_access_key: {{ secret_access_key }}
locations:
  appdata_{{inventory_hostname}}:
    from:
    - /home/ansible/appdata
    to:
    - remote
version: 2