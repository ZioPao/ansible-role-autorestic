backends:
  remote:
    type: s3
    path: {{ backblazeb2 }}/backup-pao/appdata-{{ vm }}
    key: {{ remote_key }}
    requirekey: false
    env:
      aws_access_key_id: {{ access_key_id }}
      aws_secret_access_key: {{ secret_access_key }}
    rest:
      user: ""
      password: ""
    options: {}
locations:
  appdata_{{ vm }}:
    from:
    - /home/ansible/appdata
{% if autorestic_extra_locations is defined and autorestic_extra_locations | length > 0 %}
{% for path in autorestic_extra_locations %}
    - {{ path }}
{% endfor %}
{% endif %}
    type: ""
    to:
    - remote
    hooks:
      dir: ""
      prevalidate: []
      before: []
      after: []
      success: []
      failure: []
    cron: ""
    forget: prune
    options:
      forget:
        keep-last: 5
{% if autorestic_backup_excludes is defined and autorestic_backup_excludes | length > 0 %}
      backup:
        exclude:
{% for path in autorestic_backup_excludes %}
          - {{ path }}
{% endfor %}
{% endif %}
    copyoption: {}
version: 2